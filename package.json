{
  "name": "tzar-hub",
  "private": true,
  "version": "1.0.0",
  "description": "TZAR Hub: a free, keyless and open-source Roblox script hub. Website (React + Vite) and the Cmdr Panel (Luau).",
  "license": "MIT",
  "homepage": "https://hub.2md.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2md55nmxkw-arch/tzar-hub.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts vite.config.ts",
    "format": "oxfmt src vite.config.ts scripts",
    "format:check": "oxfmt --check src vite.config.ts scripts",
    "preview": "vite preview",
    "check:site": "node scripts/check-site.mjs",
    "check:theme": "node scripts/check-theme-transition.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.59.0",
    "medeo-font": "^1.1.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.81.0",
    "playwright": "1.64.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
